---
interface Props {
  name: string;
  bio: string;
  profileImage: string;
  twitterUrl?: string;
}

const { name, bio, profileImage, twitterUrl } = Astro.props;
---

<section class="profile">
  <h1 class="gradient-text">{name}</h1>
  <p class="bio" set:html={bio.replace(/http(s)?:\/\/[\w.-]+\.[\w.-]+([\w\-\._~:/?#[\]@!$&'()*+,;=.]+)?/g, '<a href="$&" target="_blank" rel="noopener noreferrer" class="bio-link">$&</a>')}></p>
  
  {twitterUrl && (
    <a 
      href={twitterUrl} 
      class="social-link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Follow ${name} on X (formerly Twitter)`}
    >
      <svg class="twitter-logo" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
      </svg>
      <span class="sr-only">X (Twitter)</span>
    </a>
  )}
</section>

<style>
  .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: var(--spacing-xl) 0;
    animation: fadeIn 0.6s ease-out;
  }
  

  
  .profile h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: var(--spacing-xs);
    text-align: center;
  }
  
  .bio {
    max-width: 500px;
    text-align: center;
    color: var(--text-secondary);
    margin-bottom: var(--spacing-md);
    font-size: 1.1rem;
    font-weight: 300;
    white-space: pre-line;
  }
  
  .bio-link {
    color: var(--primary-500);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--transition-normal);
  }
  
  .bio-link:hover {
    color: var(--primary-600);
    text-decoration: underline;
  }
  
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    color: var(--text);
    text-decoration: none;
    font-size: 1.25rem;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 2px solid #333;
    transition: all var(--transition-normal);
  }
  
  .social-link:hover {
    transform: scale(1.1);
    background: var(--card-bg-hover);
    box-shadow: var(--shadow-md);
  }
  
  .twitter-logo {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>